<title>Ananth Pillai — Data, Risk & Business Analyst Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1B3A5C;
    --navy-deep:#122943;
    --teal:#2C6E6E;
    --teal-soft:#E8F1F0;
    --amber:#B8763D;
    --paper:#FAF8F4;
    --card:#FFFFFF;
    --ink:#22303F;
    --ink-soft:#5B6B7A;
    --line:#E1DFD8;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter',sans-serif;line-height:1.55;}
  .wrap{max-width:1040px;margin:0 auto;padding:0 28px;}
  a{color:inherit;}

  /* HERO */
  header.hero{background:linear-gradient(160deg,var(--navy-deep) 0%,var(--navy) 62%,var(--teal) 130%);color:#fff;padding:64px 0 46px;}
  .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#CFE0DD;margin:0 0 14px;}
  h1{font-family:'Source Serif 4',serif;font-weight:700;font-size:44px;margin:0 0 10px;letter-spacing:-.01em;}
  .role-line{font-size:18px;color:#DCE7E4;margin:0 0 22px;font-weight:500;}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:26px;}
  .chip{font-size:12.5px;font-family:'IBM Plex Mono',monospace;padding:5px 11px;border:1px solid rgba(255,255,255,.35);border-radius:20px;color:#EEF3F1;}
  .locline{font-size:14px;color:#B9C9D3;}

  .statbar{background:var(--navy-deep);}
  .stats{display:flex;flex-wrap:wrap;}
  .stat{flex:1 1 0;min-width:130px;padding:22px 10px;text-align:center;border-right:1px solid rgba(255,255,255,.08);}
  .stat:last-child{border-right:none;}
  .stat .num{font-family:'Source Serif 4',serif;font-size:30px;color:var(--amber);font-weight:700;}
  .stat .lab{font-size:11.5px;color:#AEC2CB;margin-top:4px;letter-spacing:.03em;}

  section{padding:56px 0;}
  h2.section-title{font-family:'Source Serif 4',serif;font-size:26px;color:var(--navy);margin:0 0 6px;}
  .section-sub{color:var(--ink-soft);font-size:14.5px;margin:0 0 28px;}

  /* FILTER TABS */
  .tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;}
  .tab{font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:.02em;padding:8px 15px;border-radius:6px;border:1px solid var(--line);background:#fff;color:var(--ink-soft);cursor:pointer;transition:.15s;}
  .tab:hover{border-color:var(--teal);color:var(--teal);}
  .tab.active{background:var(--navy);border-color:var(--navy);color:#fff;}

  .cards{display:flex;flex-wrap:wrap;gap:18px;}
  .card{flex:1 1 45%;min-width:300px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:22px 24px;transition:.15s;}
  .card:hover{border-color:var(--teal);box-shadow:0 4px 18px rgba(27,58,92,.07);}
  .card .cat{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--teal);font-weight:600;}
  .card h3{font-family:'Source Serif 4',serif;font-size:18.5px;margin:8px 0 3px;color:var(--navy);}
  .card .meta{font-size:12.5px;color:var(--ink-soft);margin-bottom:11px;}
  .card p{font-size:14px;color:#3C4854;margin:0 0 13px;}
  .tags{display:flex;flex-wrap:wrap;gap:6px;}
  .tag{font-size:11px;font-family:'IBM Plex Mono',monospace;background:var(--teal-soft);color:var(--teal);padding:3px 9px;border-radius:12px;}
  .new-badge{display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10px;background:var(--amber);color:#fff;padding:2px 7px;border-radius:4px;margin-left:8px;vertical-align:middle;letter-spacing:.05em;}

  /* SKILLS */
  .skillgrid{display:flex;flex-wrap:wrap;gap:20px;}
  .skillblock{flex:1 1 28%;min-width:200px;}
  .skillblock h4{font-size:13px;font-family:'IBM Plex Mono',monospace;color:var(--navy);text-transform:uppercase;letter-spacing:.06em;margin:0 0 10px;border-bottom:2px solid var(--teal-soft);padding-bottom:8px;}
  .skillblock ul{list-style:none;margin:0;padding:0;font-size:13.5px;color:var(--ink-soft);}
  .skillblock li{padding:3px 0;}

  /* TIMELINE */
  .tl-item{border-left:2px solid var(--teal-soft);padding:0 0 26px 22px;position:relative;}
  .tl-item::before{content:'';position:absolute;left:-6px;top:4px;width:10px;height:10px;border-radius:50%;background:var(--teal);}
  .tl-item .role{font-weight:700;color:var(--navy);font-size:15.5px;}
  .tl-item .org{color:var(--teal);font-size:13.5px;font-weight:600;}
  .tl-item .dates{font-size:12.5px;color:var(--ink-soft);font-style:italic;margin-bottom:6px;}
  .tl-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;}
  .tl-tag{font-size:10.5px;font-family:'IBM Plex Mono',monospace;background:#F1EFE9;color:var(--ink-soft);padding:2px 8px;border-radius:10px;}

  footer{background:var(--navy-deep);color:#CFE0DD;padding:34px 0;text-align:center;font-size:13.5px;}
  footer strong{color:#fff;}
  footer .avail{margin-top:8px;color:var(--amber);font-family:'IBM Plex Mono',monospace;font-size:12px;}

  @media(max-width:720px){
    .card{flex:1 1 100%;}
    .stat{flex:1 1 50%;}
    .skillblock{flex:1 1 100%;}
    h1{font-size:32px;}
  }
</style>
</head>
